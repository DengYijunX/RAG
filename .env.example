# Embedding（硅基流动）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=BAAI/bge-m3

# LLM（DeepSeek）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# 切片参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索参数
TOP_K=4

# 本地存储
PERSIST_DIR=./chroma_db
