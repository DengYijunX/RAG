# Embedding（阿里云 MaaS，OpenAI 兼容模式）
EMBEDDING_BASE_URL=https://llm-k5ve8qaaz1tn5w7b.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Rerank（阿里云 MaaS；接口形态与 chat/embeddings 不同，见 docs/ENVIRONMENT.md）
RERANK_BASE_URL=https://llm-k5ve8qaaz1tn5w7b.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=sk-xxx
RERANK_MODEL=qwen3.7-text-rerank

# LLM（DeepSeek）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# 切片参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索参数
TOP_K=4

# 向量后端：faiss（默认，精确检索）或 chroma（近似 HNSW）
# 默认 faiss 的原因：本机 Chroma 的 hnswlib 在约 96 个 1024 维向量以上会崩溃，
# 产品自己的索引根本建不起来（866 片更不可能）。两者排序实测完全一致，
# 所以这是部署选择而非质量差异；需要近似索引或已有 Chroma 集合时改回 chroma。
RAG_VECTOR_BACKEND=faiss

# 深池 + 重排（0 = 关闭；需同时填好上面的 RERANK_*）
# 开启后：先取 RAG_RETRIEVAL_DEPTH 个候选 → 用重排模型给前 RAG_RERANK_POOL 个打分
# → 取 TOP_K 个送生成。输出仍是 TOP_K 个片段，只是改成"重排挑出来的"。
# 保留测试集实测：比纯向量 recall 高 14.5pp（售后）/ 11.1pp（会计），上下文几乎不变，
# 代价约 0.8 秒/题。见 HELDOUT_TEST_REPORT.md
RAG_RETRIEVAL_DEPTH=50
RAG_RERANK_POOL=20

# 邻段扩展半径（0=关闭）。实测未被证明有益，且会因引用变长而使答案评审失准，
# 因此默认关闭；开启前请先做人工审阅。
RAG_CONTEXT_RADIUS=0

# 本地存储
PERSIST_DIR=./chroma_db
